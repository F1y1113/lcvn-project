  "episodes": [
    {
      "id": "outdoor",
      "source_archive": "val_unseen.tar",
      "source_archive_lfs_sha256": "f4da7552df485b4ad7c026eafa6bf300dcdcdb6486d1af239671f248d6d61b55",
      "frames_count": 17,
      "instructions": {
        "concise": {
          "style": "concise",
          "raw_field_name": "instruction",
          "archive_member_pkl": "val_unseen/20210826_40_0001_02_0/traj_data.pkl",
          "sha256": "a5364782d4d1dd6e27f21f814ea4a52ee07481a87e8e8777ffe3459d8c17f9a3",
          "text": "Drive straight along the dirt path, and stop at the end of the path."
        },
        "intricate": {
          "style": "intricate",
          "raw_field_name": "instruction",
          "archive_member_pkl": "val_unseen/20210826_40_0001_02_1/traj_data.pkl",
          "sha256": "77551b8cab8cce7fbc648f83c28af3371685914b5ebe2c1047a516c516b54990",
          "text": "Proceed forward on the narrow, rocky dirt trail surrounded by tall green grass and dense trees on both sides. The path leads directly up a gentle slope towards a clearing in the distance. Continue driving straight along this single track, maintaining a steady course through the vegetation, and stop once you reach the end of the visible trail near the top of the incline."
        },
        "landmark": {
          "style": "landmark",
          "raw_field_name": "instruction",
          "archive_member_pkl": "val_unseen/20210826_40_0001_02_2/traj_data.pkl",
          "sha256": "543cfefdadcf52a229883581023492662800f42027e50afa07e1a3ec32ea63a8",
          "text": "Drive straight along the dirt path bordered by tall grass and trees. Continue following the track as it heads uphill towards the clearing, and stop at the end of the path."
        }
      },
