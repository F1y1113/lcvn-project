      "instructions": {
        "concise": {
          "style": "concise",
          "suffix": "_0",
          "archive_member_pkl": "val_seen/Dec-06-2022-bww8_00000001_2_3_0_0/traj_data.pkl",
          "raw_field_name": "instruction",
          "sha256": "cdc3e7e3fbbddf5da7d33111facc19b5d8410ab414a24396da7f4266ec4401c6",
          "text": "Walk straight down the hallway, turn left at the corner, and stop near the end of the corridor."
        },
        "intricate": {
          "style": "intricate",
          "suffix": "_1",
          "archive_member_pkl": "val_seen/Dec-06-2022-bww8_00000001_2_3_0_1/traj_data.pkl",
          "raw_field_name": "instruction",
          "sha256": "770e4712ce8421d26ddd605a218c77192b9f9a9455afaa8798c744fed9e1a671",
          "text": "Start by walking straight down a long, carpeted hallway with large windows on the right and white walls on the left. As you proceed, you will pass several office-like structures and a blue recycling bin on the right. Continue forward until you reach a distinct corner where the hallway bends. Turn left at this corner and walk a short distance further down the new section of the hallway, then stop."
        },
        "landmark": {
          "style": "landmark",
          "suffix": "_2",
          "archive_member_pkl": "val_seen/Dec-06-2022-bww8_00000001_2_3_0_2/traj_data.pkl",
          "raw_field_name": "instruction",
          "sha256": "2ef10fe437e1d7d04ed2d0828839a804c357dac07654ed1cc817f3ac0885a3ab",
          "text": "Walk straight down the hallway, passing a blue recycling bin on your right. Continue until you reach the corner where the hallway turns, then turn left and stop near the end of the corridor."
        }
      },
